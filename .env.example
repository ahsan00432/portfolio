# Gmail example:
# 1. Enable 2-Step Verification on the Gmail account.
# 2. Create an App Password for "Mail".
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=a3216572@gmail.com
# SMTP_PASS=replace-with-gmail-app-password
# SMTP_FROM=a3216572@gmail.com
# CONTACT_EMAIL=a3216572@gmail.com

# Outlook / Microsoft 365 example:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-address@outlook.com
# SMTP_PASS=your-account-password-or-app-password
# SMTP_FROM=your-address@outlook.com
# CONTACT_EMAIL=your-address@outlook.com

PORT=3000
